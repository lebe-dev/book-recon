# book-recon image version for docker-compose (no latest fallback). `just deploy` sets it.
IMAGE_TAG=0.8.0

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF

# Users allowed to access the bot (comma-separated, no @, case-insensitive).
# If empty — access is managed via approve/deny flow.
ALLOWED_USERS=johndoe,janedoe

# Bot administrators (can approve/deny users, send broadcasts)
ADMIN_USERS=johndoe

# Bot locale: en (default), ru
LOCALE=en

# Path to SQLite database
DB_PATH=book-recon.db

# Log level: debug, info, warn, error
LOG_LEVEL=info

# User-Agent for HTTP requests to providers
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36

# --- Sentry error reporting (optional) ---
# Leave SENTRY_DSN empty to disable Sentry. Only error/fatal logs and panics are
# reported; performance tracing and profiling are off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Timeout for a single provider search. Flibusta may need several round trips
# (search page, then author pages), so keep it generous.
PROVIDER_TIMEOUT=30s

# --- Flibusta ---
FLIBUSTA_BASE_URL=https://flibusta.is
FLIBUSTA_ENABLED=true
# Engine: "default" (HTML scraper) or "v2" (OPDS)
FLIBUSTA_ENGINE=default

# --- RoyalLib ---
ROYALLIB_BASE_URL=https://royallib.com
ROYALLIB_ENABLED=false

# --- RuTracker via Jackett ---
# RuTracker requires a running Jackett instance (see docker-compose.yml).
# Initial setup:
#   1. Generate a random string, put it in jackett/ServerConfig.json (field "APIKey")
#      and here in JACKETT_API_KEY — they must match.
#   2. Start Jackett: docker compose up -d jackett
#   3. Open Web UI via SSH tunnel:
#        ssh -L 9117:localhost:9117 your-server
#        then http://localhost:9117
#   4. Add indexer "RuTracker.RU", enter your RuTracker login/password
RUTRACKER_ENABLED=false

# Jackett instance URL. No need to change when using docker-compose.
JACKETT_URL=http://localhost:9117
# docker
# JACKETT_URL=http://jackett:9117

# Jackett API key. Must match "APIKey" in jackett/ServerConfig.json.
# Required when RUTRACKER_ENABLED=true.
JACKETT_API_KEY=

# Indexer name in Jackett. Default "rutracker" — matches what is created when adding RuTracker.RU.
JACKETT_INDEXER=rutracker

# Comma-separated Torznab category IDs to filter search results.
# Empty = no filtering (all categories). Example: 7000 = all books.
# Find category IDs in Jackett UI → indexer → Categories.
JACKETT_CATEGORIES=7000

# HTTP timeout for Jackett requests. RuTracker sits behind Cloudflare: when the
# clearance cookie expires, Jackett asks FlareSolverr to solve a challenge (up to 55s),
# so keep this above that. PROVIDER_TIMEOUT must be at least as long.
JACKETT_TIMEOUT=60s

# Torrent download timeout (Go duration: 5m, 10m, 1h)
RUTRACKER_DOWNLOAD_TIMEOUT=5m

# Maximum number of books from a single torrent to send to the user
RUTRACKER_MAX_BOOKS=5

# Maximum torrent size in bytes (52428800 = 50 MB). Larger torrents will be rejected.
RUTRACKER_MAX_TORRENT_SIZE=52428800

# Directory for temporary torrent files. Cleared on bot startup.
RUTRACKER_DOWNLOAD_DIR=/tmp/book-recon-torrents

# --- Audiobooks (RuTracker via Jackett) ---
# Uses the same Jackett instance and JACKETT_URL / JACKETT_API_KEY / JACKETT_INDEXER as above,
# but works independently of RUTRACKER_ENABLED.
# Users search with /audio <query>, pick files from the torrent, and get a web link.
# Files are served over plain HTTP (AUDIOBOOKS_HTTP_LISTEN) — put nginx in front of it.
#
# Master switch. When false the feature is off and can't be enabled from the bot.
# When true, admins can still turn it off/on at runtime with /audiobooks.
AUDIOBOOKS_ENABLED=false

# Public base URL of the download pages, as seen by users (nginx in front of the bot).
# Required when AUDIOBOOKS_ENABLED=true. Links look like <URL>/a/<id>/
AUDIOBOOKS_PUBLIC_URL=https://audio.example.com

# Address of the built-in HTTP server that serves downloaded files.
AUDIOBOOKS_HTTP_LISTEN=:8080

# Comma-separated Torznab category IDs to search in. 3030 = Audio/Audiobook.
# RuTracker subforums are also exposed as categories: see Jackett UI → indexer → Categories.
AUDIOBOOKS_CATEGORIES=3030

# Max search results kept per query.
AUDIOBOOKS_SEARCH_LIMIT=30
# Timeout for Jackett search and .torrent download.
AUDIOBOOKS_SEARCH_TIMEOUT=30s

# Only files with these extensions are offered for selection. "*" = all files.
AUDIOBOOKS_FILE_EXTENSIONS=mp3,m4a,m4b,aac,ogg,opus,flac,wav,wma

# Where downloads are stored. Must be on a persistent volume: links survive restarts.
# docker-compose.yml overrides it with /app/data/audiobooks.
AUDIOBOOKS_DOWNLOAD_DIR=audiobooks

# Sizes accept B, KB, MB, GB, TB (binary: 1 GB = 1024 MB) or plain bytes.
# Max total size of files selected for a single download.
AUDIOBOOKS_MAX_DOWNLOAD_SIZE=4GB
# Max size of a single file; larger files can't be selected.
AUDIOBOOKS_MAX_FILE_SIZE=2GB
# Disk quota for all audiobooks (ready + in progress). New downloads are rejected when full.
AUDIOBOOKS_STORAGE_MAX_SIZE=20GB

# How long a download link stays valid. Files are deleted afterwards.
AUDIOBOOKS_LINK_TTL=24h

# Hard limit for a single download (Go duration).
AUDIOBOOKS_DOWNLOAD_TIMEOUT=3h
# Abort a download if no data arrives for this long.
AUDIOBOOKS_STALL_TIMEOUT=10m

# Downloads running at the same time; the rest wait in a queue.
AUDIOBOOKS_MAX_CONCURRENT=2
# Active (running + queued) downloads per user.
AUDIOBOOKS_MAX_PER_USER=1

# How often the progress message in Telegram is updated.
AUDIOBOOKS_PROGRESS_INTERVAL=30s

# Upload to peers while downloading. The .torrent carries your RuTracker passkey,
# so downloading without uploading hurts your account ratio. No seeding after completion.
AUDIOBOOKS_ALLOW_UPLOAD=true
